class MyHashMap {
public:

    const int SIZE = 100;
    vector<vector<pair<int,int>>>table;
    MyHashMap() {
      table.resize(SIZE);
    }

    void put(int key, int value) 
    {
        int index = key % SIZE;
        for(auto &p:table[index])
        {
    if(p.first==key)
    {
    p.second=value;    
        }
    }
    table[index].push_back({key,value});

}
    int get(int key) {
        int index = key % SIZE;
        for(auto &p:table[index]){
            if(p.first==key){
                return p.second;
            }
        }
        return -1;
    }

    void remove(int key) {
        int index = key % SIZE;
        for(auto &p:table[index]){
            if(p.first==key){
                p.second=-1;
                return;
            }
        }
    }
};


